# Database Settings
POSTGRES_USER="plane"
POSTGRES_PASSWORD=""
POSTGRES_DB="plane"
PGDATA="/var/lib/postgresql/data"

# Redis Settings
REDIS_HOST="plane-redis"
REDIS_PORT="6379"

# RabbitMQ Settings
RABBITMQ_HOST="plane-mq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="plane"
RABBITMQ_PASSWORD=""
RABBITMQ_VHOST="plane"

LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443

# AWS Settings
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_ENDPOINT_URL="http://plane-minio:9000"
# Changing this requires change in the proxy config for uploads if using minio setup
AWS_S3_BUCKET_NAME="uploads"
# Maximum file upload limit
FILE_SIZE_LIMIT=5242880

# GPT settings
OPENAI_API_BASE="https://api.openai.com/v1" # deprecated
OPENAI_API_KEY="sk-" # deprecated
GPT_ENGINE="gpt-3.5-turbo" # deprecated

# Settings related to Docker
DOCKERIZED=1  # deprecated

# set to 1 If using the pre-configured minio setup
USE_MINIO=1

# If SSL Cert to be generated, set CERT_EMAIl="email <EMAIL_ADDRESS>"
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
TRUSTED_PROXIES=127.0.0.1/32
SITE_ADDRESS=:80
CERT_EMAIL=

# For DNS Challenge based certificate generation, set the CERT_ACME_DNS, CERT_EMAIL
# CERT_ACME_DNS="acme_dns <CERT_DNS_PROVIDER> <CERT_DNS_PROVIDER_API_KEY>"
CERT_ACME_DNS=

# Force HTTPS for handling SSL Termination
MINIO_ENDPOINT_SSL=0

# API key rate limit
API_KEY_RATE_LIMIT="60/minute"

# Ancen production: select a successfully published tag; never use latest for upgrades.
ANCEN_VERSION=0.1.0-rc.2
LISTEN_ADDRESS=127.0.0.1
# Set all three to the public HTTPS origin (no trailing slash).
WEB_URL=https://plane.example.com
APP_BASE_URL=https://plane.example.com
ADMIN_BASE_URL=https://plane.example.com
ADMIN_BASE_PATH=/god-mode
SPACE_BASE_URL=https://plane.example.com
SPACE_BASE_PATH=/spaces
LIVE_BASE_URL=https://plane.example.com
LIVE_BASE_PATH=/live
CORS_ALLOWED_ORIGINS=https://plane.example.com
ALLOWED_HOSTS=plane.example.com,api,localhost,127.0.0.1
DEBUG=0
SECRET_KEY=
LIVE_SERVER_SECRET_KEY=
GUNICORN_WORKERS=2
POSTGRES_HOST=plane-db
POSTGRES_PORT=5432
REDIS_URL=redis://plane-redis:6379/
ENABLE_SIGNUP=0
NUM_PROXIES=1

# authentik: copy EXACT issuer and discovery URL from your configured provider.
OIDC_ENABLED=false

# Upload transport: POST preserves MinIO/S3 compatibility; R2 requires PUT.
# For R2 also set USE_MINIO=0, AWS_REGION=auto and AWS_S3_ENDPOINT_URL
# to https://<ACCOUNT_ID>.r2.cloudflarestorage.com. Keep the bucket private.
S3_UPLOAD_METHOD=POST
OIDC_ISSUER=
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://plane.example.com/auth/oidc/callback/
OIDC_ADMIN_REDIRECT_URI=https://plane.example.com/api/instances/oidc/callback/
OIDC_SCOPES=openid profile email
OIDC_AUTO_PROVISION=true
# Keep true until BOTH SSO and restricted admin recovery are verified.
OIDC_ALLOW_LOCAL_LOGIN=true
OIDC_ALLOWED_EMAIL_DOMAINS=
OIDC_PROVIDER_NAME=Ancen SSO
OIDC_BUTTON_TEXT=Continuar con Ancen SSO
OIDC_SHOW_BUTTON=true
OIDC_SESSION_MAX_AGE=28800
OIDC_ADMIN_RECOVERY_UNTIL=0
OIDC_ADMIN_RECOVERY_IPS=
